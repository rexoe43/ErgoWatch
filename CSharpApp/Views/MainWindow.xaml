<Window x:Class = "CSharpApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ErgoWatch"
    Height="450"
    Width="800"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBloc Grid.Row="0"
                    Text="ErgoWatch"
                    FontSize="24"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Margin="20"/>

        <StackPaner Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBloc x:Name="StatusTextBlock"
                        Text="Monitoring..."
                        FontSize="18"
                        Margin="10"/>
            <TextBloc x:Name="LastAlertText"
                        Text="Last ALert: None"
                        FontSize="14"
                        Margin="10"
                        Foreground="Gray"/>
            <TextBloc x:Nam="TimerText"
                        Text="00:00:00"
                        FontSize="14"
                        Margin="10"
                        Foreground="Blue"/>
        </StackPaner>
    </Grid>
</Window>